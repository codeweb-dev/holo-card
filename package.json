{
  "name": "react-holo-card",
  "version": "0.3.7",
  "description": "A React component that renders a pointer-reactive holographic card effect (Pokemon-card style foil + glare + sparkle).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react",
    "dev": "tsup src/index.tsx --format esm --dts --watch --external react",
    "test": "node --experimental-strip-types --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "holo",
    "card",
    "effect",
    "pokemon",
    "foil",
    "tilt"
  ],
  "license": "MIT",
  "author": "Allen Labrague",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeweb-dev/holo-card.git"
  },
  "homepage": "https://github.com/codeweb-dev/holo-card#readme",
  "bugs": {
    "url": "https://github.com/codeweb-dev/holo-card/issues"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.0",
    "react-dom": "^18.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "react-parallax-tilt": "^1.7.333"
  }
}
